<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Surat Cinta Untukmu ❤️</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <style>
        /* Efek Hati Berjatuhan */
        .heart {
            position: fixed;
            color: red;
            font-size: 24px;
            opacity: 0.8;
        }

        /* Efek Scroll */
        .scroll-animate {
            opacity: 0;
            transform: translateY(50px);
            transition: opacity 1s ease-out, transform 1s ease-out;
        }

        /* Desain Surat */
        .scroll {
            background: url('https://source.unsplash.com/800x1200/?parchment') no-repeat center center/cover;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.3);
            max-width: 600px;
            text-align: center;
        }

        /* Galeri Foto */
        .photo-frame {
            border: 5px solid white;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(255, 105, 180, 0.5);
            width: 180px;
            height: 180px;
            object-fit: cover;
            transition: transform 0.3s ease-in-out;
        }
        .photo-frame:hover {
            transform: scale(1.1);
        }
    </style>
</head>
<body class="flex flex-col items-center justify-center min-h-screen bg-pink-200 text-gray-900 text-center relative">

    <!-- Musik Romantis -->
    <audio id="music" autoplay loop>
        <source src="https://www.bensound.com/bensound-music/bensound-romantic.mp3" type="audio/mp3">
    </audio>

    <!-- Hati Berjatuhan -->
    <script>
        function createHeart() {
            const heart = document.createElement("div");
            heart.className = "heart";
            heart.innerHTML = "❤️";
            heart.style.left = Math.random() * 100 + "vw";
            heart.style.fontSize = Math.random() * 15 + 20 + "px";
            document.body.appendChild(heart);

            gsap.fromTo(heart, 
                { y: -20, opacity: 1 },
                { y: window.innerHeight, opacity: 0, duration: Math.random() * 5 + 2, ease: "linear",
                onComplete: () => heart.remove() 
            });
        }
        setInterval(createHeart, 500);
    </script>

    <!-- Gulungan Surat -->
    <div id="scroll" class="scroll hidden fade-in w-full max-w-lg">
        <h2 class="text-3xl font-bold text-red-500">Untukmu, Cinta Sejatiku ❤️</h2>
        <p class="mt-3 text-lg italic text-gray-700">
            "Aku mencintaimu lebih dari yang bisa aku ucapkan...  
            Setiap detik bersamamu adalah anugerah,  
            dan aku ingin selalu bersamamu selamanya."
        </p>

        <!-- Pesan Rahasia -->
        <p id="secret-message" class="mt-3 text-lg italic text-gray-700 opacity-0">
            "Aku akan selalu mencintaimu, hari ini, esok, dan selamanya. 💖"
        </p>

        <!-- Galeri Foto Kenangan dengan Harapan -->
        <div class="mt-8 space-y-8">
            <div class="scroll-animate">
                <img src="https://source.unsplash.com/180x180/?couple,love" class="photo-frame mx-auto">
                <p class="mt-2 text-gray-700 font-semibold">Semoga kita selalu bahagia bersama 💕</p>
            </div>
            <div class="scroll-animate">
                <img src="https://source.unsplash.com/180x180/?romance,happy" class="photo-frame mx-auto">
                <p class="mt-2 text-gray-700 font-semibold">Aku ingin selalu ada di sisimu 💖</p>
            </div>
            <div class="scroll-animate">
                <img src="https://source.unsplash.com/180x180/?together,smile" class="photo-frame mx-auto">
                <p class="mt-2 text-gray-700 font-semibold">Semoga cinta kita terus tumbuh dan abadi 💞</p>
            </div>
            <div class="scroll-animate">
                <img src="https://source.unsplash.com/180x180/?forever,couple" class="photo-frame mx-auto">
                <p class="mt-2 text-gray-700 font-semibold">Aku ingin menghabiskan seluruh hidupku bersamamu 💍</p>
            </div>
        </div>
    </div>

    <!-- Tombol Buka Surat -->
    <button id="openScroll" class="mt-5 px-5 py-3 bg-red-500 text-white text-lg font-bold rounded-lg shadow-lg hover:bg-red-600 transition duration-300">
        📜 Buka Surat
    </button>

    <script>
        // Membuka surat dengan efek animasi
        document.getElementById("openScroll").addEventListener("click", function() {
            let scrollDiv = document.getElementById("scroll");
            scrollDiv.classList.remove("hidden");
            gsap.fromTo(scrollDiv, { opacity: 0, scale: 0.8 }, { opacity: 1, scale: 1, duration: 1 });

            setTimeout(() => {
                gsap.to("#secret-message", { opacity: 1, duration: 1.5 });
            }, 2000);

            this.classList.add("hidden");
        });

        // Efek animasi saat scroll yang selalu aktif
        function scrollAppear() {
            let elements = document.querySelectorAll('.scroll-animate');
            elements.forEach((element) => {
                let position = element.getBoundingClientRect().top;
                if (position < window.innerHeight - 50) {
                    gsap.to(element, { opacity: 1, y: 0, duration: 1, ease: "power2.out" });
                } else {
                    gsap.to(element, { opacity: 0, y: 30, duration: 1, ease: "power2.out" });
                }
            });
        }
        window.addEventListener('scroll', scrollAppear);
    </script>

</body>
</html>